# --- Go ---
backend/tmp/
backend/backend
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out

# --- Embedded frontend build artifact (S9) ---
# frontend/dist gets copied here for go:embed; keep only the placeholder so
# `go build`/`go test` still work from a clean checkout without a frontend
# build. See backend/web/web.go.
backend/web/dist/*
!backend/web/dist/.gitkeep

# --- Node / Vue / Vite ---
frontend/node_modules/
frontend/dist/
frontend/.vite/
*.local

# --- Editors / IDE ---
.idea/
.vscode/*
!.vscode/extensions.json

# --- Claude Code (local/session-specific) ---
.claude/settings.local.json
.claude/scheduled_tasks.lock

# --- OS ---
.DS_Store

# --- Env ---
.env
.env.*
!.env.example
