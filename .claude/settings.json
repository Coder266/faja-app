{
  "env": {
    "DISABLE_AUTOUPDATER": "1"
  },
  "permissions": {
    "allow": [
      "Bash",
      "Edit",
      "Write",
      "Read",
      "Glob",
      "Grep",
      "Agent",
      "TaskCreate",
      "TaskUpdate",
      "TaskList",
      "TaskGet",
      "TaskOutput",
      "TaskStop",
      "Edit(.claude/agents/**)",
      "Write(.claude/agents/**)",
      "Edit(.claude/skills/**)",
      "Write(.claude/skills/**)",
      "Edit(.claude/commands/**)",
      "Write(.claude/commands/**)",
      "Edit(CLAUDE.md)",
      "Write(CLAUDE.md)"
    ],
    "ask": [
      "Edit(.claude/**)",
      "Write(.claude/**)",
      "Edit(.devcontainer/**)",
      "Write(.devcontainer/**)",
      "WebFetch",
      "WebSearch",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(npm install *)",
      "Bash(npm ci *)",
      "Bash(npm add *)",
      "Bash(go get *)",
      "Bash(go install *)",
      "Bash(go mod download *)",
      "Bash(pip install *)",
      "Bash(apt-get install *)",
      "Bash(apt install *)",
      "Bash(sudo apt-get install *)",
      "Bash(sudo apt install *)",
      "Bash(git clone *)",
      "Bash(gh release download *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(curl *)",
            "command": "cmd=$(jq -r '.tool_input.command'); if echo \"$cmd\" | grep -qE '(localhost|127\\.0\\.0\\.1)'; then printf %s '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"allow\",\"permissionDecisionReason\":\"curl targeting localhost\"}}'; fi"
          }
        ]
      }
    ]
  }
}
