{
  "name": "Go + Vue + Claude Code",
  "image": "mcr.microsoft.com/devcontainers/go:1-bookworm",
  "features": {
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {},
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "mounts": [
    "source=claude-code-config-${devcontainerId},target=/home/vscode/.claude,type=volume",
    "source=claude-code-bashhistory-${devcontainerId},target=/commandhistory,type=volume",
    "source=gh-cli-config-${devcontainerId},target=/home/vscode/.config/gh,type=volume"
  ],
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude",
    "GH_CONFIG_DIR": "/home/vscode/.config/gh",
    "PLAYWRIGHT_BROWSERS_PATH": "/home/vscode/.cache/ms-playwright"
  },
  "postCreateCommand": "cd frontend && npm install && npx playwright install --with-deps chromium",
  "customizations": {
    "jetbrains": {
      "backend": "GoLand",
      "plugins": [
        "org.jetbrains.plugins.vue"
      ]
    }
  },
  "remoteUser": "vscode",
  "containerUser": "vscode"
}
